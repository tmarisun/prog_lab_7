# PostgreSQL PRO (postgrepro.dc-edu.ru). Скопируйте в .env и подставьте свой номер ИСУ.
#
# Логин:  bk_<номер_ИСУ>_2026
# Пароль: bk_<номер_ИСУ>  (рекомендуется сменить: ALTER USER ... WITH PASSWORD '...')
# Схема:  совпадает с логином

PG_HOST=postgrepro.dc-edu.ru
PG_PORT=5432
PG_DATABASE=dbstud
PG_USER=bk_502786_2026
PG_PASSWORD=bk_502786
PG_SCHEMA=bk_502786_2026

# Не добавляйте currentSchema= в PG_JDBC_URL — на PostgreSQL PRO он даёт
# «unsupported startup parameter: search_path». Схема задаётся через PG_SCHEMA и SET search_path.
# PG_JDBC_URL=jdbc:postgresql://postgrepro.dc-edu.ru:5432/dbstud

AUTO_CREATE_DATABASE=false
SERVER_PORT=5234
# SSH-туннель: SERVER_HOST=127.0.0.1 (локальный порт = SERVER_PORT)
