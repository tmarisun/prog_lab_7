# Скопируйте в .env на helios или экспортируйте переменные перед ./gradlew runServer.
#
# Сервер (SSH на helios):
PG_HOST=pg
PG_PORT=5432
PG_DATABASE=studs
PG_USER=s502786
# Пароль отдельно; при символах вроде > & $ используйте одинарные кавычки:
# PG_PASSWORD='...'
# Оставьте false, если БД studs уже есть (типично на helios). true — только при праве CREATEDB.
AUTO_CREATE_DATABASE=false
SERVER_PORT=5555
#
# Клиент с вашего компьютера (к helios):
# SERVER_HOST=helios.cs.ifmo.ru
# SERVER_PORT=5555
#
# Если gradlew на helios не стартует («Gradle build daemon») — соберите JAR на своём ПК:
#   bash gradlew shadowJar
#   scp build/libs/lab-all.jar helios:~/labuba7/prog_lab7/build/libs/
# Сервер (на helios нужен заранее скопированный build/libs/lab-all.jar):
#   bash scripts/helios-run-server.sh 5555
# Если очень нужно дернуть Gradle на helios: USE_GRADLE=1 bash scripts/helios-run-server.sh 5555
# Клиент: export SERVER_HOST=localhost SERVER_PORT=5555 && bash scripts/helios-run-client.sh
#
# Либо на helios после удачного gradle:
#   bash gradlew --no-daemon --max-workers=1 writeServerClasspath
#   bash scripts/run-client-jvm.sh
#
# Полный JDBC при необходимости:
# PG_JDBC_URL=jdbc:postgresql://pg:5432/studs
